---
interface Props {
  src: string;
  title?: string;
}

const { src, title } = Astro.props;
const isYouTube =
  /^[\w-]{11}$/.test(src) ||
  /^https?:\/\/(www\.|m\.)?(youtube\.com|youtube-nocookie\.com|youtu\.be)\//.test(src);
---

<figure class="w-full my-8">
  <video-player>
    <video-skin>
      {
        isYouTube ? (
          <youtube-video src={src} class="w-full aspect-video" />
        ) : (
          <video src={src} playsinline controls />
        )
      }
    </video-skin>
  </video-player>
  {
    title && (
      <figcaption class="font-heading text-center text-text-subtle text-sm mt-2">
        {title}
      </figcaption>
    )
  }
</figure>

<script>
  // @ts-ignore
  import "@videojs/html/video/player";
  // @ts-ignore
  import "@videojs/html/video/skin";
  // @ts-ignore
  import "@videojs/html/media/youtube-video";
</script>
